# ─────────────────────────────────────────────────────────────────────────────
# backend/.env.example
# Copy this to .env and fill in the values for local development.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase ──────────────────────────────────────────────────────────────────

# Option A (recommended for local): path to your service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=../capstone-project-96d2e-firebase-adminsdk-fbsvc-1848a2c079.json

# Option B (used on Render.com): paste the entire JSON as a single-line string
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"capstone-project-96d2e",...}

FIREBASE_PROJECT_ID=capstone-project-96d2e

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ── File size limits ──────────────────────────────────────────────────────────
MAX_IMAGE_SIZE_MB=50
MAX_VIDEO_SIZE_MB=500

# ── HuggingFace cache ─────────────────────────────────────────────────────────
# Models are downloaded here on first run (~530 MB total).
# Leave blank to use the default ~/.cache/huggingface
# HF_CACHE_DIR=./.cache/huggingface

# ── Dev mode ──────────────────────────────────────────────────────────────────
# Set to "true" to skip Firebase token verification during local development.
# NEVER set to "true" in production.
SKIP_AUTH=false
