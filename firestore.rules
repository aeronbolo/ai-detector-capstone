rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── users ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Own document — full access
      allow read, write: if isOwner(userId);
      // Admin — can read, update AND delete any user document
      allow read, update, delete: if isAdmin();
      // Any authenticated user can create their own doc on registration
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // Allow reading user docs for login lookup (studentId/employeeId lookup)
      // This is needed before authentication so we can find email by student/employee ID
      allow read: if true;
    }

    // ── detections ─────────────────────────────────────────────────────────
    match /detections/{detectionId} {
      // Users can read/write their own detections
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow write: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      // Users can create new detections for themselves
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      // Admin — full access
      allow read, write: if isAdmin();
    }

    // ── reports ────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      // Users can read/write their own reports
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow write: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      // Admin can read all
      allow read: if isAdmin();
    }

    // ── activity_logs ──────────────────────────────────────────────────────
    match /activity_logs/{logId} {
      allow create: if isAuthenticated();
      allow read:   if isAdmin();
    }

    // ── classes ────────────────────────────────────────────────────────────────
    match /classes/{classId} {
      // Anyone can read classes (needed for joining by code during registration)
      allow read: if true;
      // Teachers can create their own classes
      allow create: if isAuthenticated() &&
        request.resource.data.teacherId == request.auth.uid;
      // Teachers can fully update their own classes
      allow update, delete: if isAuthenticated() &&
        resource.data.teacherId == request.auth.uid;
      // Students can update class to add themselves (join)
      allow update: if isAuthenticated();
      // Admin full access
      allow read, write: if isAdmin();
    }

    // ── submissions ────────────────────────────────────────────────────────────
    match /submissions/{submissionId} {
      // Any authenticated user can read submissions
      // Security enforced at application level — students query by studentId,
      // teachers query by classId/teacherId
      allow read: if isAuthenticated();
      // Students can create their own submissions
      allow create: if isAuthenticated() &&
        request.resource.data.studentId == request.auth.uid;
      // Students and teachers can update submissions
      allow update: if isAuthenticated();
      // Admin full access
      allow read, write: if isAdmin();
    }

    // ── settings ───────────────────────────────────────────────────────────
    match /settings/{docId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
